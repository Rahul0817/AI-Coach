# =============================================================================
# Oviora AI — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit the populated `.env`.
# =============================================================================

# ---- Application ----
APP_NAME="Oviora AI"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-64-byte-random-string-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of allowed browser origins.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- PostgreSQL ----
POSTGRES_USER=oviora
POSTGRES_PASSWORD=oviora_dev_password
POSTGRES_DB=oviora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full override; if unset it is assembled from the parts above.
# DATABASE_URL=postgresql+asyncpg://oviora:oviora_dev_password@localhost:5432/oviora

# ---- Redis (cache, rate limiting, conversation working memory) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100            # requests per window, per identity
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS=20        # tighter budget for expensive LLM routes
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ---- LLM provider ----
# Provider is pluggable: openai | local
# `local` uses the built-in retrieval-grounded provider and needs no API key,
# so the whole product remains demoable without external credentials.
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1200
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Embeddings / RAG ----
EMBEDDING_PROVIDER=local           # openai | local
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION=oviora_pcos_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# ---- Machine learning ----
ML_ARTIFACT_DIR=./ml/artifacts
ML_MODEL_FILE=pcos_risk_model.joblib

# ---- Conversation memory ----
MEMORY_WINDOW_MESSAGES=12          # verbatim recent turns kept in the prompt
MEMORY_SUMMARY_TRIGGER=20          # summarise once a thread exceeds this
MEMORY_TTL_SECONDS=86400

# ---- Cloudinary (media storage; falls back to local disk when unset) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- OCR ----
TESSERACT_CMD=tesseract

# ---- Frontend (consumed by Next.js at build time) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
